#!/usr/bin/env python3
"""Read mail out of Thunderbird's local store.

Thunderbird exists on this machine purely to keep mailboxes synced to disk —
notably support@movepeople.ch, which the Microsoft 365 connector cannot reach
(no delegate access) and which cannot be synced with mbsync either (Microsoft
disabled basic-auth IMAP). Thunderbird speaks Microsoft OAuth itself, so it is
the one thing that can log in without an admin grant.

This reads what it has already downloaded: offline, no API quota, and Sent is
right there, which is what answers "did I actually reply?".

Handles both storage formats: mbox (Thunderbird's default) and maildir.
"""

from __future__ import annotations

import argparse
import base64
import email
import email.utils
import json
import os
import re
import sys
from datetime import datetime, timedelta, timezone
from email.header import decode_header, make_header

TB_ROOT = os.path.expanduser(os.environ.get("IR_TB_ROOT", "~/.thunderbird"))

# Files Thunderbird keeps next to a folder that are not the folder itself.
SKIP_SUFFIX = (".msf", ".dat", ".sbd", ".log", ".json", ".sqlite", ".ini", ".html")
SKIP_NAMES = {"msgFilterRules.dat", "filterlog.html", "popstate.dat", "tmp"}


# ---------------------------------------------------------------- discovery

def profiles() -> list:
    """Every Thunderbird profile directory, newest-looking first."""
    ini = os.path.join(TB_ROOT, "profiles.ini")
    found = []
    if os.path.isfile(ini):
        section, data = None, {}
        for raw in open(ini, encoding="utf-8", errors="replace"):
            line = raw.strip()
            if line.startswith("[") and line.endswith("]"):
                if section and "Path" in data:
                    found.append(data)
                section, data = line[1:-1], {}
            elif "=" in line:
                k, v = line.split("=", 1)
                data[k.strip()] = v.strip()
        if section and "Path" in data:
            found.append(data)

    paths = []
    for d in found:
        p = d["Path"]
        full = p if os.path.isabs(p) else os.path.join(TB_ROOT, p)
        if os.path.isdir(full):
            paths.append(full)

    # profiles.ini can be absent or stale; fall back to scanning.
    if not paths and os.path.isdir(TB_ROOT):
        for name in os.listdir(TB_ROOT):
            full = os.path.join(TB_ROOT, name)
            if os.path.isdir(full) and (
                os.path.isdir(os.path.join(full, "ImapMail"))
                or os.path.isdir(os.path.join(full, "Mail"))
            ):
                paths.append(full)
    return paths


# ---------------------------------------------------------------- folder names
# IMAP encodes non-ASCII folder names in modified UTF-7 (RFC 3501), and
# Thunderbird stores them on disk exactly as the server named them. This mailbox
# is German, so "Gesendete Elemente" is fine but "Entw&APw-rfe" is Entwürfe.
# Decode for display, and keep matching on the decoded form.

def decode_imap_utf7(name: str) -> str:
    out, i = [], 0
    while i < len(name):
        ch = name[i]
        if ch != "&":
            out.append(ch)
            i += 1
            continue
        end = name.find("-", i + 1)
        if end == -1:
            out.append(ch)
            i += 1
            continue
        chunk = name[i + 1:end]
        if chunk == "":
            out.append("&")
        else:
            try:
                b64 = chunk.replace(",", "/")
                b64 += "=" * (-len(b64) % 4)
                out.append(base64.b64decode(b64).decode("utf-16-be"))
            except Exception:
                out.append(name[i:end + 1])
        i = end + 1
    return "".join(out)


def is_maildir(path: str) -> bool:
    return os.path.isdir(path) and os.path.isdir(os.path.join(path, "cur"))


def looks_like_mbox(path: str) -> bool:
    if not os.path.isfile(path):
        return False
    if path.endswith(SKIP_SUFFIX) or os.path.basename(path) in SKIP_NAMES:
        return False
    try:
        with open(path, "rb") as fh:
            head = fh.read(5)
        return head == b"From " or os.path.getsize(path) == 0
    except OSError:
        return False


def folders() -> list:
    """Every readable folder, as (account, folder-name, path, kind)."""
    out = []
    for prof in profiles():
        for store in ("ImapMail", "Mail"):
            root = os.path.join(prof, store)
            if not os.path.isdir(root):
                continue
            for account in sorted(os.listdir(root)):
                adir = os.path.join(root, account)
                if not os.path.isdir(adir):
                    continue
                for dirpath, dirnames, filenames in os.walk(adir):
                    # .sbd directories hold subfolders; walk into them but never
                    # treat one as a folder itself.
                    dirnames[:] = [d for d in dirnames if d not in ("tmp",)]
                    for name in sorted(dirnames):
                        full = os.path.join(dirpath, name)
                        if is_maildir(full):
                            out.append((account, rel_name(adir, full), full, "maildir"))
                    for name in sorted(filenames):
                        full = os.path.join(dirpath, name)
                        if looks_like_mbox(full):
                            out.append((account, rel_name(adir, full), full, "mbox"))
    return out


def rel_name(account_dir: str, path: str) -> str:
    rel = os.path.relpath(path, account_dir)
    rel = rel.replace(".sbd/", "/").replace(os.sep, "/")
    return "/".join(decode_imap_utf7(part) for part in rel.split("/"))


# ---------------------------------------------------------------- reading

def decode(value) -> str:
    if not value:
        return ""
    try:
        return str(make_header(decode_header(value)))
    except Exception:
        return str(value)


def msg_date(msg) -> datetime | None:
    raw = msg.get("Date")
    if not raw:
        return None
    try:
        dt = email.utils.parsedate_to_datetime(raw)
    except (TypeError, ValueError):
        return None
    if dt and not dt.tzinfo:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt


def body_text(msg) -> str:
    """Plain text body, falling back to stripped HTML."""
    parts = []
    if msg.is_multipart():
        for part in msg.walk():
            if part.get_content_maintype() == "multipart":
                continue
            if part.get_filename():
                continue
            ctype = part.get_content_type()
            if ctype not in ("text/plain", "text/html"):
                continue
            try:
                raw = part.get_payload(decode=True) or b""
                text = raw.decode(part.get_content_charset() or "utf-8", "replace")
            except Exception:
                continue
            parts.append(strip_html(text) if ctype == "text/html" else text)
    else:
        try:
            raw = msg.get_payload(decode=True) or b""
            text = raw.decode(msg.get_content_charset() or "utf-8", "replace")
            parts.append(strip_html(text) if msg.get_content_type() == "text/html" else text)
        except Exception:
            pass
    return "\n".join(parts)


def strip_html(html: str) -> str:
    html = re.sub(r"(?is)<(script|style).*?</\1>", " ", html)
    html = re.sub(r"(?s)<[^>]+>", " ", html)
    html = re.sub(r"&nbsp;?", " ", html)
    html = re.sub(r"&amp;?", "&", html)
    html = re.sub(r"&lt;?", "<", html)
    html = re.sub(r"&gt;?", ">", html)
    return re.sub(r"[ \t]{2,}", " ", html)


def iter_messages(path: str, kind: str):
    if kind == "maildir":
        for sub in ("cur", "new"):
            d = os.path.join(path, sub)
            if not os.path.isdir(d):
                continue
            for name in sorted(os.listdir(d)):
                f = os.path.join(d, name)
                if not os.path.isfile(f):
                    continue
                try:
                    with open(f, "rb") as fh:
                        yield email.message_from_binary_file(fh)
                except Exception:
                    continue
        return

    # mbox: split on "From " at the start of a line. Read incrementally so a
    # large folder does not have to be held in memory twice.
    try:
        with open(path, "rb") as fh:
            buf = []
            for line in fh:
                if line.startswith(b"From ") and buf:
                    try:
                        yield email.message_from_bytes(b"".join(buf))
                    except Exception:
                        pass
                    buf = []
                    continue
                if line.startswith(b"From ") and not buf:
                    continue
                buf.append(line)
            if buf:
                try:
                    yield email.message_from_bytes(b"".join(buf))
                except Exception:
                    pass
    except OSError:
        return


# ---------------------------------------------------------------- search

def parse_since(s: str | None) -> datetime | None:
    if not s:
        return None
    m = re.match(r"^(\d+)\s*([dwhm])$", s.strip(), re.I)
    now = datetime.now(timezone.utc)
    if m:
        n, unit = int(m.group(1)), m.group(2).lower()
        delta = {"h": timedelta(hours=n), "d": timedelta(days=n),
                 "w": timedelta(weeks=n), "m": timedelta(days=30 * n)}[unit]
        return now - delta
    try:
        dt = datetime.fromisoformat(s)
        return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)
    except ValueError:
        sys.exit(f"ir-mail: can't read {s!r} as a time. Try 2d, 12h, 1w or an ISO date.")


# Deleted and junk mail is weak evidence at best — a message in the bin is not
# proof the information is in hand — so it stays out unless asked for.
NOISE = ("trash", "deleted", "gelöschte", "junk", "spam", "papierkorb")
SENT = ("sent", "gesendet")
DRAFTS = ("draft", "entwürfe", "entwurf")


def is_noise(name: str) -> bool:
    low = name.lower()
    return any(w in low for w in NOISE) or any(w in low for w in DRAFTS)


def want_folder(name: str, which: str, include_noise: bool = False) -> bool:
    low = name.lower()
    if not include_noise and is_noise(name):
        return False
    if which == "all":
        return True
    if which == "inbox":
        return low == "inbox" or low.startswith("inbox/")
    if which == "sent":
        return any(w in low for w in SENT)
    return True


def search(args) -> int:
    since = parse_since(args.since)
    terms = [t.lower() for t in (args.query or [])]
    hits = []

    for account, name, path, kind in folders():
        if not want_folder(name, args.folder, args.include_trash):
            continue
        for msg in iter_messages(path, kind):
            dt = msg_date(msg)
            if since and (not dt or dt < since):
                continue
            frm = decode(msg.get("From"))
            to = decode(msg.get("To"))
            cc = decode(msg.get("Cc"))
            subj = decode(msg.get("Subject"))

            if args.sender and args.sender.lower() not in frm.lower():
                continue
            if args.to and args.to.lower() not in (to + " " + cc).lower():
                continue

            body = body_text(msg) if (terms or args.body) else ""
            if terms:
                hay = " ".join([frm, to, cc, subj, body]).lower()
                if not all(t in hay for t in terms):
                    continue

            hits.append({
                "account": account,
                "folder": name,
                "date": dt.isoformat() if dt else "",
                "from": frm,
                "to": to,
                "subject": subj,
                "message_id": (msg.get("Message-ID") or "").strip(),
                "body": body.strip() if args.body else snippet(body),
            })

    hits.sort(key=lambda h: h["date"], reverse=True)
    hits = hits[: args.limit]

    if args.json:
        print(json.dumps(hits, indent=2, ensure_ascii=False))
        return 0

    if not hits:
        print("no matching mail.")
        return 0

    for h in hits:
        print(f"── {h['date'][:16]}  [{h['folder']}]")
        print(f"   from: {h['from']}")
        if h["to"]:
            print(f"   to:   {h['to']}")
        print(f"   subj: {h['subject']}")
        if h["body"]:
            for line in h["body"].splitlines():
                if line.strip():
                    print(f"   | {line.rstrip()}")
        print()
    return 0


def snippet(body: str, limit: int = 400) -> str:
    text = re.sub(r"\n{3,}", "\n\n", (body or "").strip())
    lines = [l for l in text.splitlines() if l.strip() and not l.lstrip().startswith(">")]
    out = "\n".join(lines[:8])
    return out[:limit] + ("…" if len(out) > limit else "")


def cmd_folders(args) -> int:
    rows = folders()
    if args.json:
        print(json.dumps([
            {"account": a, "folder": n, "kind": k, "path": p} for a, n, p, k in rows
        ], indent=2))
        return 0
    if not rows:
        print("No Thunderbird mail found.")
        print(f"  looked in: {TB_ROOT}")
        print("  Is Thunderbird installed, and has it synced an account yet?")
        return 0
    for account, name, path, kind in rows:
        try:
            size = os.path.getsize(path) if kind == "mbox" else len(
                os.listdir(os.path.join(path, "cur")))
        except OSError:
            size = 0
        unit = "bytes" if kind == "mbox" else "msgs"
        print(f"  {account:34} {name:24} {kind:8} {size} {unit}")
    return 0


def cmd_status(args) -> int:
    profs = profiles()
    print(f"thunderbird root : {TB_ROOT}")
    print(f"profiles         : {len(profs)}")
    for p in profs:
        print(f"  {p}")
    rows = folders()
    print(f"folders readable : {len(rows)}")
    newest = ""
    for _, _, path, kind in rows:
        try:
            m = datetime.fromtimestamp(os.path.getmtime(path), timezone.utc).isoformat()
            newest = max(newest, m)
        except OSError:
            pass
    print(f"most recent write: {newest[:19] or 'never'}")
    return 0


def main() -> int:
    p = argparse.ArgumentParser(
        prog="ir-mail",
        description="Read mail from Thunderbird's local store (mbox or maildir).")
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("search", help="find messages")
    s.add_argument("query", nargs="*", help="all terms must appear")
    s.add_argument("--since", default="14d", help="12h, 7d, 2w or an ISO date (default 14d)")
    s.add_argument("--from", dest="sender", help="filter by sender")
    s.add_argument("--to", help="filter by recipient (To or Cc)")
    s.add_argument("--folder", choices=["inbox", "sent", "all"], default="all")
    s.add_argument("--limit", type=int, default=15)
    s.add_argument("--body", action="store_true", help="print full bodies, not snippets")
    s.add_argument("--include-trash", action="store_true",
                   help="also search deleted, junk and drafts (off by default: "
                        "a binned message is weak evidence)")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=search)

    f = sub.add_parser("folders", help="what is available locally")
    f.add_argument("--json", action="store_true")
    f.set_defaults(fn=cmd_folders)

    st = sub.add_parser("status", help="is the local store there and fresh")
    st.set_defaults(fn=cmd_status)

    args = p.parse_args()
    if not getattr(args, "fn", None):
        args = p.parse_args(["folders"])
    return args.fn(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
